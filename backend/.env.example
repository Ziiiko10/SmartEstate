SMARTESTATE_USE_MANAGED_SERVICES=True
DATABASE_FALLBACK_TO_SQLITE=False
DATABASE_SSL_REQUIRE=True
DATABASE_CONN_MAX_AGE=600

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
SMARTESTATE_PUBLIC_DEMO_ACCESS=True
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
REDIS_URL=rediss://default:PASSWORD@HOST:PORT/0
CELERY_BROKER_URL=rediss://default:PASSWORD@HOST:PORT/0

MARKET_ETL_PAGES=50
MARKET_ETL_SLEEP_SECONDS=1
MARKET_ETL_TIMEOUT_SECONDS=20
MARKET_ETL_STOP_AFTER_EXISTING=30
MARKET_ETL_INTERVAL_SECONDS=1800
