DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,backend,api.smartestate.example
DJANGO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://app.smartestate.example
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://app.smartestate.example

SMARTESTATE_PUBLIC_DEMO_ACCESS=True
SMARTESTATE_USE_MANAGED_SERVICES=True
DATABASE_FALLBACK_TO_SQLITE=False
DATABASE_SSL_REQUIRE=True
DATABASE_CONN_MAX_AGE=600

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
REDIS_URL=rediss://default:PASSWORD@HOST:PORT/0
CELERY_BROKER_URL=rediss://default:PASSWORD@HOST:PORT/0

MARKET_ETL_PAGES=50
MARKET_ETL_SLEEP_SECONDS=1
MARKET_ETL_TIMEOUT_SECONDS=20
MARKET_ETL_STOP_AFTER_EXISTING=30
MARKET_ETL_INTERVAL_SECONDS=1800

VITE_APP_NAME=SmartEstate
VITE_API_BASE_URL=https://api.smartestate.example/api
VITE_PUBLIC_DEMO_ACCESS=true
